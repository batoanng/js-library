{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "outputs": ["dist/**", ".next/**", "generators/**/*.js"],
      "dependsOn": ["^build"],
      "env": ["ANALYZE"]
    },
    "test": {},
    "lint": {},
    "format": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "cache": false
    }
  }
}
