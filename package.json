{
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:docs:pages": "NEXT_STATIC_EXPORT=true pnpm --filter @batoanng/docs... build",
    "build:release": "pnpm -r --filter './packages/*' build",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "lint": "turbo run lint",
    "prepush": "pnpm -r --if-present run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write --list-different .",
    "check:packaging": "node ./scripts/check-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build:release && changeset publish",
    "prepare": "husky install",
    "ci": "pnpm run lint && pnpm run test && pnpm run build && pnpm run check:packaging"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "^3.4.0",
    "@batoanng/prettier-config": "^1.7.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@next/bundle-analyzer": "^16.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "esbuild-jest": "^0.5.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "next": "^16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-html-props": "^2.1.1",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "csstype": "^3.2.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "^10.0.0"
      }
    }
  },
  "packageManager": "pnpm@10.12.3"
}
