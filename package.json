{
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:release": "pnpm -r --filter './packages/*' build",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write --list-different .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build:release && changeset publish",
    "prepare": "husky install",
    "ci": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "workspace:*",
    "@batoanng/prettier-config": "workspace:*",
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@next/bundle-analyzer": "^13.4.19",
    "@testing-library/jest-dom": "^5.17.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "esbuild": "^0.19.2",
    "esbuild-jest": "^0.5.0",
    "eslint": "^9.39.4",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "lint-staged": "^14.0.0",
    "next": "^13.4.19",
    "prettier": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-html-props": "^2.0.3",
    "tsup": "^8.5.0",
    "turbo": "^1.10.12",
    "typescript": "^5.1.6",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.28",
      "@types/react-dom": "^18.3.7",
      "csstype": "^3.2.3"
    }
  },
  "packageManager": "pnpm@10.12.3",
  "dependencies": {
    "dist": "link:packages/t-generator/dist"
  }
}
