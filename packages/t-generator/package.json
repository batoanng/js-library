{
  "name": "generator-t-generator",
  "version": "0.5.2",
  "description": "Yeoman generators for bootstrapping React apps, Next.js apps, NestJS servers, and Node.js servers.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/generators/index.js",
  "files": [
    "dist/generators/**/*.js",
    "dist/generators/**/templates/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "yeoman-generator",
    "yeoman",
    "react",
    "nextjs",
    "nestjs",
    "nodejs",
    "express",
    "prisma",
    "tailwindcss",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check",
    "lint": "eslint generators test scripts eslint.config.mjs --max-warnings 0",
    "test": "pnpm run build && TEST_TARGET=build node --import tsx/esm --test test/*.test.ts",
    "clean:build": "node scripts/clean-build-output.cjs",
    "clean": "pnpm run clean:build",
    "build": "pnpm run clean:build && tsc -p tsconfig.build.json && node scripts/rewrite-dist-imports.cjs && node scripts/stage-dist.cjs",
    "link:dev": "npm --prefix ./dist install && cd ./dist && npm link",
    "test:dist": "pnpm run build && DIST_SMOKE=1 TEST_TARGET=dist node --import tsx/esm --test test/dist-package.test.ts",
    "prepack": "pnpm run build",
    "postpack": "pnpm run clean:build",
    "release": "pnpm run build && npm publish ./dist"
  },
  "dependencies": {
    "mem-fs": "^4.1.4",
    "yeoman-generator": "^8.2.2"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "^3.4.0",
    "@batoanng/prettier-config": "^1.7.1",
    "@batoanng/tsconfig": "^1.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@yeoman/adapter": "^4.0.2",
    "tsx": "^4.21.0",
    "yeoman-assert": "^3.1.1",
    "yeoman-environment": "^6.1.0",
    "yeoman-test": "^11.4.2"
  }
}
