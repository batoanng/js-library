{
  "name": "generator-t-generator",
  "version": "0.4.0",
  "description": "Yeoman generators for bootstrapping React apps, Next.js apps, NestJS servers, and Node.js servers.",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "generators/index.js",
  "files": [
    "generators/**/*.js",
    "generators/**/templates/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "yeoman-generator",
    "yeoman",
    "react",
    "nextjs",
    "nestjs",
    "nodejs",
    "express",
    "prisma",
    "tailwindcss",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check",
    "lint": "eslint generators test scripts eslint.config.mjs --max-warnings 0",
    "test": "node --import tsx --test test/*.test.ts",
    "clean:build": "node scripts/clean-build-output.cjs",
    "clean": "pnpm run clean:build",
    "build": "pnpm run clean:build && tsc -p tsconfig.build.json && node scripts/stage-dist.cjs",
    "link:dev": "npm --prefix ./dist link",
    "test:dist": "pnpm run build && DIST_SMOKE=1 TEST_TARGET=dist node --import tsx --test test/dist-package.test.ts",
    "prepack": "pnpm run build",
    "postpack": "pnpm run clean:build",
    "release": "npm publish"
  },
  "dependencies": {
    "yeoman-generator": "^5.10.0"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "workspace:*",
    "@batoanng/prettier-config": "workspace:*",
    "@batoanng/tsconfig": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/yeoman-generator": "^5.2.14",
    "tsx": "^4.21.0",
    "yeoman-assert": "^3.1.1",
    "yeoman-test": "^7.4.0"
  }
}
