import { env } from '@/shared/config';
import Link from 'next/link';

export function AuthPage() {
  return (
    <main className="page">
      <section className="hero">
        <p className="eyebrow">Authentication example</p>
        <h1>{env.auth0.isConfigured ? 'Auth0 route handling is ready' : 'Connect Auth0'}</h1>
        <p>
          The generated Auth0 integration uses <code>@auth0/nextjs-auth0</code>,
          a server-side <code>Auth0Client</code>, and Next middleware to expose
          login, logout, callback, profile, and access-token routes.
        </p>
        <ul>
          <li>APP_BASE_URL</li>
          <li>AUTH0_SECRET</li>
          <li>AUTH0_DOMAIN</li>
          <li>AUTH0_CLIENT_ID</li>
          <li>AUTH0_CLIENT_SECRET</li>
          <li>AUTH0_AUDIENCE (optional)</li>
        </ul>
        {env.auth0.isConfigured ? (
          <p>
            Try the generated endpoints:
            {' '}
            <a href="/auth/login">/auth/login</a>,
            {' '}
            <a href="/auth/logout">/auth/logout</a>,
            {' '}
            <a href="/auth/profile">/auth/profile</a>.
          </p>
        ) : (
          <p>
            Add your Auth0 values to <code>.env.local</code>, restart the dev
            server, and then return to this route to try the hosted login flow.
          </p>
        )}
        <p>
          <Link href="/">Back to the main page</Link>
        </p>
      </section>
    </main>
