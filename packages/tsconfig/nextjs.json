{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "strict": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "pages", "components", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
