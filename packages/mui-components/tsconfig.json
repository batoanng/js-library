{
  "extends": "@batoanng/tsconfig/reactjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsxImportSource": "@emotion/react"
  },
  "mdx": {
    "plugins": [["remark-frontmatter", ["toml", "yaml"]], "remark-gfm"]
  },
  "include": ["tooling", "src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
