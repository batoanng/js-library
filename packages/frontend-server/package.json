{
  "name": "@batoanng/frontend-server",
  "author": "Ba Toan Nguyen",
  "version": "2.8.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/frontend-server.cjs",
  "module": "./dist/frontend-server.js",
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "lint": "eslint index.ts src vite.config.ts vitest.config.ts eslint.config.mjs --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "test": "vitest --run --config vitest.config.ts",
    "type-check": "tsc --noEmit",
    "tag:create": "node scripts/create-tag.js",
    "tag:patch": "npm run tag:create patch",
    "tag:minor": "npm run tag:create minor",
    "tag:major": "npm run tag:create major",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/frontend-server.js",
      "require": "./dist/frontend-server.cjs"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "mime-types": "^3.0.2"
  },
  "peerDependenciesMeta": {
    "http-proxy-middleware": {
      "optional": true
    }
  },
  "devDependencies": {
    "@batoanng/eslint-config": "^3.4.0",
    "@batoanng/prettier-config": "^1.7.1",
    "@batoanng/tsconfig": "^1.6.0",
    "@batoanng/vite-config": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/mime-types": "^3.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  }
}
