{
  "extends": "@batoanng/tsconfig/node24.json",
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "Node",
    "outDir": "./dist",
    "noEmit": false,
    "sourceMap": true,
    "baseUrl": ".",
    "types": ["vite/client", "node", "vitest/globals"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["index.ts", "src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
