{
  "name": "@batoanng/oidc",
  "version": "3.0.5",
  "license": "MIT",
  "author": "Ba Toan Nguyen",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/oidc.js",
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.css",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/assets/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:watch": "nodemon --exec 'pnpm run build && yalc push'",
    "format": "prettier . --write --ignore-path .gitignore && git update-index --again",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "pnpm run build && vite preview --port 3000",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:updateSnapshot": "vitest -u",
    "test:coverage": "vitest --silent --watchAll=false --coverage",
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check"
  },
  "peerDependencies": {
    "@batoanng/mui-components": "^3.5.4",
    "@emotion/react": "^11.13.5",
    "@mui/material": "6.1.8",
    "axios": "1.9.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.2.4",
    "react-hook-form": "7.57.0",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.26.1",
    "react-use": "^17.4.0"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "^3.3.2",
    "@batoanng/prettier-config": "^1.7.0",
    "@batoanng/tsconfig": "^1.5.1",
    "@batoanng/vite-config": "^1.3.1",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "axios": "^1.14.0",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^16.6.1",
    "jsdom": "^26.1.0",
    "nodemon": "^2.0.22",
    "prettier": "2.8.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  },
  "overrides": {
    "@mdx-js/react": {
      "react": "$react"
    }
  }
}
