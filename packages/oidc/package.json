{
  "name": "@batoanng/oidc",
  "version": "3.1.0",
  "license": "MIT",
  "author": "Ba Toan Nguyen",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/oidc.js",
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.css",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/assets/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:watch": "nodemon --exec 'pnpm run build && yalc push'",
    "format": "prettier . --write --ignore-path .gitignore && git update-index --again",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "pnpm run build && vite preview --port 3000",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:updateSnapshot": "vitest -u",
    "test:coverage": "vitest --silent --watchAll=false --coverage",
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check"
  },
  "peerDependencies": {
    "@batoanng/mui-components": "^3.6.0",
    "@emotion/react": "^11.14.0",
    "@mui/material": "9.0.0",
    "axios": "1.15.2",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.5",
    "react-hook-form": "7.74.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.14.2",
    "react-use": "^17.4.0"
  },
  "devDependencies": {
    "@batoanng/eslint-config": "^3.4.0",
    "@batoanng/prettier-config": "^1.7.1",
    "@batoanng/tsconfig": "^1.6.0",
    "@batoanng/vite-config": "^1.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.15.2",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  },
  "overrides": {
    "@mdx-js/react": {
      "react": "$react"
    }
  }
}
