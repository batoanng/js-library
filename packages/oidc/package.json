{
  "name": "@batoanng/oidc",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Ba Toan Nguyen",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/oidc.js",
  "files": [
    "src",
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:watch": "nodemon --exec 'pnpm run build && yalc push'",
    "format": "prettier . --write --ignore-path .gitignore && git update-index --again",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "pnpm run build && vite preview --port 3000",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:updateSnapshot": "vitest -u",
    "test:coverage": "vitest --silent --watchAll=false --coverage",
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check"
  },
  "peerDependencies": {
    "@batoanng/mui-components": "workspace:*",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "6.1.8",
    "@mui/material": "6.1.8",
    "@mui/utils": "^6.1.8",
    "@mui/x-date-pickers": "7.22.2",
    "axios": "1.9.0",
    "oidc-client": "^1.11.5",
    "oidc-client-ts": "^3.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "^5.0.2",
    "react-hook-form": "7.44.3",
    "react-idle-timer": "^5.7.2",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.26.1",
    "react-use": "^17.4.0"
  },
  "peerDependenciesMeta": {
    "@mui/x-date-pickers": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    },
    "react-idle-timer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@batoanng/eslint-config": "workspace:*",
    "@batoanng/prettier-config": "workspace:*",
    "@batoanng/tsconfig": "workspace:*",
    "@batoanng/vite-config": "workspace:*",
    "@mdx-js/mdx": "^2.3.0",
    "@mdx-js/react": "^1.6.22",
    "@mdx-js/rollup": "^2.3.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "15.0.7",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/google-translate-api": "^2.3.5",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "axios": "^1.14.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-loader": "^8.4.1",
    "chalk": "^5.6.2",
    "commander": "^10.0.1",
    "conf": "^11.0.2",
    "dotenv": "^16.6.1",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^13.3.0",
    "nodemon": "^2.0.22",
    "prettier": "2.8.8",
    "react-test-renderer": "^18.3.1",
    "sort-package-json": "^1.57.0",
    "tsc-watch": "^6.3.1",
    "typescript": "5.0.4",
    "vite-plugin-svgr": "4.3.0",
    "xdm": "^3.4.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10"
  },
  "overrides": {
    "@mdx-js/react": {
      "react": "$react"
    }
  }
}
